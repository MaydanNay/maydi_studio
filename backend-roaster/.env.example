# App
APP_NAME=AI Offer Roaster
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1

# CORS - comma-separated origins, or * for all
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000

# LLM (OpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_WOW=gpt-4o
OPENAI_TIMEOUT_SECONDS=90
MAX_COMPLETION_TOKENS=2500
TEMPERATURE=0.4

# Jina.ai Reader (optional API key raises rate limits)
JINA_READER_BASE_URL=https://r.jina.ai
JINA_API_KEY=
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_MAX_CHARS=12000

# Roast behaviour
ROAST_OBJECTION_COUNT=3
ROAST_JSON_RETRIES=2
TWO_PASS_ENABLED=true

# Rate limiting (per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WOW_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=3600

# Lead capture
LEADS_FILE=data/leads.jsonl
# Optional: notify founders via Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
